---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <!-- SECTION 01 — HERO -->
  <section class="min-h-[85vh] flex flex-col justify-end pb-24 px-4 md:px-8 border-b border-neutral-900 relative">
    <div class="absolute inset-0 z-[-1] bg-neutral-950 flex items-center justify-center opacity-50">
      <span class="text-neutral-800 text-sm tracking-widest">[ ASSET PLACEHOLDER: DOMINANT COMPONENT IMAGE OR RENDER ]</span>
    </div>
    
    <div class="max-w-6xl z-10">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold uppercase tracking-tighter leading-[0.9] mb-8">
        Precision-machined components.<br/>
        <span class="text-neutral-400 italic">Made to your specifications.</span>
      </h1>
      <p class="text-lg md:text-2xl max-w-3xl text-neutral-300 font-light leading-relaxed mb-12">
        Custom component manufacturing through CNC, VMC, and fourth-axis machining, with capabilities for exotic-grade alloys.
      </p>
      <div class="flex flex-col sm:flex-row gap-6">
        <a href="/request-a-quote/" class="bg-white text-black px-8 py-4 uppercase text-sm font-bold hover:bg-neutral-200 transition-colors inline-block text-center">Request a quote</a>
        <a href="/capabilities/" class="border border-neutral-700 text-white px-8 py-4 uppercase text-sm font-bold hover:bg-neutral-900 transition-colors inline-block text-center">Explore capabilities</a>
      </div>
    </div>
  </section>

  <!-- SECTION 02 — CAPABILITY INDEX -->
  <section class="px-4 md:px-8 py-12 border-b border-neutral-900">
    <ul class="flex flex-col md:flex-row justify-between uppercase text-xs md:text-sm font-bold tracking-widest text-neutral-400">
      <li class="py-4 md:py-0 border-b md:border-b-0 border-neutral-800"><a href="/capabilities/cnc-machining/" class="hover:text-white transition-colors">01. CNC Machining</a></li>
      <li class="py-4 md:py-0 border-b md:border-b-0 border-neutral-800"><a href="/capabilities/vmc-machining/" class="hover:text-white transition-colors">02. VMC Machining</a></li>
      <li class="py-4 md:py-0 border-b md:border-b-0 border-neutral-800"><a href="/capabilities/4th-axis-machining/" class="hover:text-white transition-colors">03. Fourth-Axis Machining</a></li>
      <li class="py-4 md:py-0"><a href="/capabilities/exotic-alloy-machining/" class="hover:text-white transition-colors">04. Exotic-Alloy Machining</a></li>
    </ul>
  </section>

  <!-- SECTION 03 — ABOUT RUPAM -->
  <section class="py-32 px-4 md:px-8 border-b border-neutral-900 grid grid-cols-1 lg:grid-cols-2 gap-16">
    <div class="flex flex-col justify-center">
      <h2 class="text-4xl md:text-6xl font-bold uppercase tracking-tighter mb-12 leading-none">Built around your component requirements.</h2>
      <div class="flex gap-6">
        <a href="/about/" class="uppercase text-sm font-bold tracking-widest border-b border-white pb-1 hover:text-neutral-400 hover:border-neutral-400 transition-colors">About Rupam</a>
        <a href="/facility/" class="uppercase text-sm font-bold tracking-widest border-b border-white pb-1 hover:text-neutral-400 hover:border-neutral-400 transition-colors">Our Facility</a>
      </div>
    </div>
    <div class="bg-neutral-900 min-h-[500px] flex items-center justify-center">
      <span class="text-neutral-600 text-sm tracking-widest">[ ASSET PLACEHOLDER: FACTORY OR TEAM IMAGERY ]</span>
    </div>
  </section>

  <!-- SECTION 04 — MANUFACTURING CAPABILITIES -->
  <section class="border-b border-neutral-900">
    <div class="px-4 md:px-8 py-24 border-b border-neutral-900 grid grid-cols-1 md:grid-cols-12 gap-8 items-start hover:bg-neutral-950 transition-colors">
      <div class="md:col-span-1 text-2xl text-neutral-600 font-light">01.</div>
      <div class="md:col-span-4">
        <h3 class="text-4xl font-bold uppercase tracking-tighter mb-6"><a href="/capabilities/cnc-machining/" class="hover:underline">CNC Machining</a></h3>
        <p class="text-neutral-400 font-light">[ TODO: Descriptive copy for CNC machining. ]</p>
      </div>
      <div class="md:col-span-7 bg-neutral-900 h-64 md:h-96 flex items-center justify-center w-full">
        <span class="text-neutral-600 text-sm tracking-widest">[ PLACEHOLDER: CNC VISUAL ]</span>
      </div>
    </div>
    <div class="px-4 md:px-8 py-24 border-b border-neutral-900 grid grid-cols-1 md:grid-cols-12 gap-8 items-start hover:bg-neutral-950 transition-colors">
      <div class="md:col-span-1 text-2xl text-neutral-600 font-light">02.</div>
      <div class="md:col-span-4">
        <h3 class="text-4xl font-bold uppercase tracking-tighter mb-6"><a href="/capabilities/vmc-machining/" class="hover:underline">VMC Machining</a></h3>
